---
source: tests/ast_snapshots.rs
description: "Vim syntax family `magic` parsed from `a\\V.*\\m.\\v(x|y)\\M\\+`"
---
Ok(
    Pattern {
        source: "a\\V.*\\m.\\v(x|y)\\M\\+",
        initial_magic: Magic,
        expression: Spanned {
            value: Concat(
                [
                    Spanned {
                        value: Literal(
                            "a",
                        ),
                        span: 0..1,
                    },
                    Spanned {
                        value: MagicSwitch(
                            VeryNoMagic,
                        ),
                        span: 1..3,
                    },
                    Spanned {
                        value: Literal(
                            ".",
                        ),
                        span: 3..4,
                    },
                    Spanned {
                        value: Literal(
                            "*",
                        ),
                        span: 4..5,
                    },
                    Spanned {
                        value: MagicSwitch(
                            Magic,
                        ),
                        span: 5..7,
                    },
                    Spanned {
                        value: Dot {
                            include_newline: false,
                        },
                        span: 7..8,
                    },
                    Spanned {
                        value: MagicSwitch(
                            VeryMagic,
                        ),
                        span: 8..10,
                    },
                    Spanned {
                        value: Group {
                            kind: Capture {
                                index: 1,
                            },
                            expression: Spanned {
                                value: Alternation(
                                    [
                                        Spanned {
                                            value: Literal(
                                                "x",
                                            ),
                                            span: 11..12,
                                        },
                                        Spanned {
                                            value: Literal(
                                                "y",
                                            ),
                                            span: 13..14,
                                        },
                                    ],
                                ),
                                span: 11..14,
                            },
                        },
                        span: 10..15,
                    },
                    Spanned {
                        value: Repeat {
                            expression: Spanned {
                                value: MagicSwitch(
                                    NoMagic,
                                ),
                                span: 15..17,
                            },
                            quantifier: Quantifier {
                                min: 1,
                                max: None,
                                preference: Greedy,
                            },
                        },
                        span: 15..19,
                    },
                ],
            ),
            span: 0..19,
        },
    },
)
