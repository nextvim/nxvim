                    },
                    Spanned {
                        value: Literal(
                            "e",
                        ),
                        span: 6..7,
                    },
                    Spanned {
                        value: Literal(
                            "\u{301}",
                        ),
                        span: 7..9,
                    },
                ],
            ),
            span: 0..9,
        },
    },
