# PKGBUILD for nxvim (Arch Linux)
# Maintainer: Maintainer <m4rvin2005@gmail.com>

pkgname=nxvim
pkgver=0.1.0
pkgrel=1
_commit=ef671afa2a7834d6b83cf402cef5a6d5ce7f1bac
pkgdesc="A Vim-inspired terminal text editor written in Rust, powered by Zed's Rope engine"
arch=('x86_64' 'aarch64')
url="https://github.com/nextvim/nxvim"
license=('custom:Vim')
depends=('gcc-libs')
makedepends=('cargo' 'clang' 'pkgconf')
source=("${pkgname}-${_commit}.tar.gz::https://github.com/nextvim/${pkgname}/archive/${_commit}.tar.gz")
sha256sums=('7d58abc429cdc461bdf79d9c40d32ef7be1c3c14bd63a72da639441b43291896')

prepare() {
  cd "${pkgname}-${_commit}"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's|host: ||p')"
}

build() {
  cd "${pkgname}-${_commit}"
  export RUSTUP_TOOLCHAIN=stable
  cargo build --frozen --release
}

package() {
  cd "${pkgname}-${_commit}"
  install -Dm755 "target/release/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
