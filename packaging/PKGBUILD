# PKGBUILD for nxvim (Arch Linux)
# Maintainer: Maintainer <m4rvin2005@gmail.com>

pkgname=nxvim
pkgver=0.1.0
pkgrel=1
_commit=68d767e5710bb7ab8393b4d04217ddab77236f73
pkgdesc="A Vim-inspired terminal text editor written in Rust, powered by Zed's Rope engine"
arch=('x86_64' 'aarch64')
url="https://github.com/nextvim/nxvim"
license=('custom:Vim')
depends=('gcc-libs')
makedepends=('cargo' 'clang' 'pkgconf')
source=("${pkgname}-${_commit}.tar.gz::https://github.com/nextvim/${pkgname}/archive/${_commit}.tar.gz")
sha256sums=('f739dc7fb343c54978aab784d61bd9260f2886598d314d084c16661bef9fe012')

prepare() {
  cd "${pkgname}-${_commit}"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's|host: ||p')"
}

build() {
  cd "${pkgname}-${_commit}"
  export RUSTUP_TOOLCHAIN=stable
  cargo build --frozen --release
}

package() {
  cd "${pkgname}-${_commit}"
  install -Dm755 "target/release/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
